# EnAgent — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Ollama Model ───────────────────────────────
# The local LLM model Jake uses to think and respond
# Make sure this model is pulled via: ollama pull <MODEL_NAME>
OLLAMA_MODEL=qwen3:8b

# ─── Memory ─────────────────────────────────────
# Path to the file where Jake saves your mistakes and topics
MEMORY_FILE=memory/user_memory.json

# ─── Speech Settings ────────────────────────────
# How long Jake waits after you stop speaking before he replies (seconds)
PAUSE_THRESHOLD=2.0

# Minimum volume to detect as speech (higher = ignores more background noise)
ENERGY_THRESHOLD=300

# ─── TTS Settings ───────────────────────────────
# Jake's speaking speed (default: 150 — lower = slower)
SPEECH_RATE=150
